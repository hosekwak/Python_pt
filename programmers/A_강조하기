def solution(myString):
    answer = ''
    for i in myString:
        if i == 'a':
            answer += 'A'
        elif i.isupper() and i != 'A':
            answer += i.lower()
        else:
            answer += i
    return answer


def solution(myString):
    return ''.join('A' if c == 'a' else c if c == 'A' else c.lower() for c in myString)